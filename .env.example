# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Get free credentials at https://api-portal.tfl.gov.uk/
# Never commit .env.local

TFL_APP_ID=your-app-id
TFL_APP_KEY=your-app-key

# Optional: public site URL (used by registry install URLs)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Trademark opt-in for the official TfL roundel SVG.
# Without this, TfLRoundel renders a filled/rounded placeholder of the same size.
# With it on: customise text / ringColor / barColor, or use variant="elizabeth" etc.
# Setting the flag means YOUR app accepts trademark responsibility.
# Must be NEXT_PUBLIC_ (or VITE_) so the client bundle sees the same value as SSR.
# NEXT_PUBLIC_ALLOW_TFL_ROUNDEL=true
# VITE_ALLOW_TFL_ROUNDEL=true
