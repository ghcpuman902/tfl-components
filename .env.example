# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Site / server Primary key from https://api-portal.tfl.gov.uk/
# Register → Products → 500 Requests per min → Profile → Show.
# Profile lists Primary and Secondary keys; either works.
# This is the server-only site key (getTflClient / "use cache" / Server Actions).
# It is NOT the browser "Add TfL API key" control in the docs sidebar — that key
# stays in the visitor's localStorage/sessionStorage and never hits this env.
# Never commit .env.local

TFL_APP_KEY=your-primary-key

# Optional: DfT Bus Open Data Service key for SIRI-VM GPS (server-only).
# Shaped in this repo; not verified against a live feed yet.
# https://data.bus-data.dft.gov.uk/
# BODS_API_KEY=your-bods-key

# Optional: public site URL (defaults to https://tfl.manglekuo.com)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Trademark opt-in for the official TfL roundel SVG.
# Without this, TfLRoundel renders a filled/rounded placeholder of the same size.
# With it on: customise text / ringColor / barColor, or use variant="elizabeth" etc.
# Setting the flag means YOUR app accepts trademark responsibility.
# Must be NEXT_PUBLIC_ (or VITE_) so the client bundle sees the same value as SSR.
# NEXT_PUBLIC_ALLOW_TFL_ROUNDEL=true
# VITE_ALLOW_TFL_ROUNDEL=true

# Adobe Fonts (Typekit) kit id for P22 Underground — a closer commercial
# match to TfL's Johnston typeface than the open Hammersmith One default.
# Requires your own Adobe Fonts subscription with P22 Underground added to
# a web project kit: https://fonts.adobe.com/fonts/p22-underground
# Without this, the Typography page's font switch is still shown, but
# silently falls back to Hammersmith One (no stylesheet to resolve against).
# Must be NEXT_PUBLIC_ so the client bundle can read it too.
# NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=your-kit-id

# Resend — site feedback emails (server-only).
# Create an API key at https://resend.com/api-keys and verify mangl.es.
# RESEND_API_KEY=re_xxxxxxxxx
# Optional overrides (defaults: feedback@xxxx → xxxx@gmail.com):
# FEEDBACK_FROM=TfL Components <feedback@mangl.es>
# FEEDBACK_TO=xxxx@gmail.com

# Redis — footer site stats (visitors, installs, cached GitHub stars).
# Without this, counters soft-fail to 0 / — in the footer.
# REDIS_URL=redis://default:password@host:port

# Optional: GitHub token for higher rate limits when fetching stargazers_count.
# Unauthenticated requests still work for a single public repo.
# GITHUB_TOKEN=ghp_xxxxxxxx

# Optional: Mapbox public token (pk.*) for the live Mapbox vendor example on
# /docs/map-geographic. Public tokens are designed for the browser; restrict
# them to http://localhost:3000/* (and your production origin) in the Mapbox
# dashboard. NEXT_PUBLIC_ vars are inlined at process start — restart `next
# dev` after changing this. Keep in .env.local, not this file.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# Optional: Google Maps JavaScript API key for the live vendor example on
# /docs/map-geographic. Restrict the key to HTTP referrers
# http://localhost:3000/* (and your production origin) and enable only the
# Maps JavaScript API. Restart `next dev` after changing this.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...
