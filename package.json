    "fast-uri": "^4.2.4",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.36.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "description": "React TfL UI components and shadcn registry built on tfl-ts",
