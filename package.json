    "recharts": "3.8.0",
    "redis": "^6.4.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.41.0",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "sugar-high": "^1.3.0",
    "tailwind-merge": "^3.7.1",
    "tfl-ts": "^2.17.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
