    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.12.1",
    "flags": "^4.5.3",
    "gsap": "^3.15.1",
