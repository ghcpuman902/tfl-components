    "name": "MangleKuo",
    "url": "https://manglekuo.com"
  },
  "homepage": "https://tfl-ts.dev/",
  "packageManager": "pnpm@11.29.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs && tsx scripts/check-no-server-appkey.ts && tsx scripts/check-registry-urls.ts && tsx scripts/check-registry-imports.ts && tsx scripts/verify-track-graph.ts",
    "roundel-spin:sprite": "tsx scripts/compose-placeholder-roundel-sprite.ts",
    "roundel-spin:build": "tsx scripts/build-placeholder-roundel-sprite.ts",
    "geography:unique-track": "tsx scripts/snapshot-unique-track-geometry.ts",
    "hop-times:snapshot": "tsx scripts/snapshot-line-hop-times.ts",
    "network-model:snapshot": "tsx scripts/snapshot-network-model.ts",
    "schematics:build": "tsx scripts/build-branch-schematics.ts",
    "registry:build": "tsx scripts/build-colour-tokens.ts && shadcn build",
    "registry:check": "sh scripts/check-registry-built.sh",
    "component-graph:build": "tsx scripts/component-dependencies/build.ts",
    "component-graph:watch": "tsx scripts/component-dependencies/watch.ts",
    "explore": "tsx watch scripts/explore/playground.ts"
  },
